# ============================================================================
# MISS 17 CHIMBARONGO 2026 — VARIABLES DE ENTORNO OFICIALES
# ============================================================================
# Copia este archivo a .env y completa tus credenciales obtenidas de Supabase.
# En Vercel: Ve a Settings -> Environment Variables y agrégalas allí también.

# 1. Credenciales de Supabase (Project Settings -> API)
# URL de tu proyecto en Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública anónima (usada por el frontend para suscripciones en tiempo real y lectura)
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Llave secreta Service Role (usada EXCLUSIVAMENTE por las Serverless Functions /api/vote)
# ¡NUNCA compartas esta llave ni la expongas en el frontend!
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# 2. Seguridad de Código de Confirmación (OTP)
OTP_SECRET=miss17-chimbarongo-2026-ultra-secret-key-prod

# 3. Envío de Correo Real (Opcional - Resend)
# Si deseas que los códigos OTP lleguen por correo electrónico real:
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL="Miss 17 Chimbarongo <votaciones@miss17chimbarongo.cl>"

